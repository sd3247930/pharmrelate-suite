# 黄金基准必须保持原始字节，禁止任何换行归一化。
# 一旦被 git 转成 CRLF，字节级往返测试就会失败。
backend/tests/golden/*.xml -text
private/*.XML -text
private/*.jpg -text

# Android 侧带的基准副本必须与 backend/tests/golden/1箱3罐.xml 逐字节一致，
# 同样禁止换行归一化，否则 xmlGenerator 单测会因 CRLF 而失败。
android/tests/fixtures/*.xml -text

# 源码统一使用 LF
*.py    text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows 脚本
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.png   binary
*.ico   binary
*.exe   binary
